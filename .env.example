# ─── Core ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ─── Database (Neon or Supabase Postgres; pgvector extension required) ───────
# Pooled endpoint — used by the app at runtime.
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# ─── Auth (Auth.js v5) ───────────────────────────────────────────────────────
# Direct (non-pooled) endpoint — used by migrations only. On Neon this is the
# same URL with "-pooler" removed from the host. The pooled host is PgBouncer in
# transaction mode, which is right for serverless queries and wrong for DDL.
DATABASE_URL_UNPOOLED=

AUTH_SECRET=""                      # openssl rand -base64 32
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ─── Phone OTP (MSG91 recommended for India; Twilio as fallback) ─────────────
OTP_PROVIDER="msg91"                # msg91 | twilio | console
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""
MSG91_SENDER_ID=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""

# ─── Image storage (Vercel Blob) ─────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=""

# ─── Rate limiting / cache (Upstash Redis) ───────────────────────────────────
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─── Background jobs (Inngest) ───────────────────────────────────────────────
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# ─── Vision moderation (pick one; Sightengine is cheapest to start) ──────────
VISION_PROVIDER="sightengine"       # sightengine | hive | rekognition | none
SIGHTENGINE_USER=""
SIGHTENGINE_SECRET=""

# ─── LLM listing review (optional but recommended) ───────────────────────────
ANTHROPIC_API_KEY=""

# ─── Transactional email ─────────────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="WorthIt <noreply@example.in>"

# ─── Payments / escrow (Phase 3 — leave blank for now) ──────────────────────
PAYMENTS_PROVIDER="none"            # none | razorpay | cashfree
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ─── Observability ───────────────────────────────────────────────────────────
SENTRY_DSN=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# ─── Moderation tuning (see docs/MODERATION.md) ─────────────────────────────
PHASH_DUPLICATE_THRESHOLD="6"       # Hamming distance <= this = near-duplicate
AUTOAPPROVE_MAX_RISK_SCORE="25"     # risk <= this and no blockers -> auto-approve
AUTOREJECT_MIN_RISK_SCORE="80"      # risk >= this -> auto-reject
